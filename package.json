{
  "name": "claude-animated-shorts-engineering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "npm workspace root. It exists so sources outside studio/ (templates/bridge, src/npc) resolve the same single copy of three and postprocessing as the studio.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "npm run typecheck --workspace studio",
    "build": "npm run build --workspace studio",
    "compositions": "npm run compositions --workspace studio",
    "studio": "npm run studio --workspace studio",
    "render:video": "npm run render:video --workspace studio",
    "render:stills": "npm run render:stills --workspace studio",
    "render:all": "npm run render:all --workspace studio",
    "render:repro": "npm run render:repro --workspace studio",
    "qa:source": "python tests/visual/measure_source.py",
    "qa:compare": "python tests/visual/compare_source.py",
    "qa:shading": "python tests/visual/shading_probe.py",
    "qa:visual": "python tests/visual/run_visual_qa.py",
    "p5:venv": "node studio/scripts/p5-python.mjs --setup",
    "p5:audit": "node studio/scripts/p5-python.mjs tests/visual/p5_reference_measure.py && node studio/scripts/p5-python.mjs tests/visual/p5_reference_inventory.py",
    "p5:manifest": "node --import tsx studio/scripts/emit-p5-manifest.ts",
    "p5:audio": "node studio/scripts/p5-python.mjs studio/audio/archive_pilot_audio.py",
    "p5:audio:qa": "node studio/scripts/p5-python.mjs tests/visual/p5_audio_qa.py",
    "p5:video": "npm run p5:video --workspace studio",
    "p5:stills": "npm run p5:stills --workspace studio",
    "p5:repro": "npm run p5:repro --workspace studio",
    "p5:mux": "node --import tsx studio/scripts/mux-p5.ts",
    "p5:qa": "node studio/scripts/p5-python.mjs tests/visual/p5_video_qa.py",
    "p6:manifest": "node --import tsx studio/scripts/emit-p6-manifest.ts",
    "p6:video": "npm run p6:video --workspace studio",
    "p6:stills": "npm run p6:stills --workspace studio",
    "p6:repro": "npm run p6:repro --workspace studio",
    "p6:bench": "npm run p6:bench --workspace studio",
    "p6:mux": "node --import tsx studio/scripts/mux-p6.ts",
    "p6:qa": "node studio/scripts/p5-python.mjs tests/visual/p6_video_qa.py"
  },
  "dependencies": {
    "postprocessing": "6.39.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
