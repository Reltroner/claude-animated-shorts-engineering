# Private reference frames, original footage and everything generated by QA and renders stay on this machine.
/.local/

# Dependencies (npm workspace: everything is hoisted to the root; a nested copy can appear under studio/)
node_modules/

# Remotion output and caches. Anchored to studio/ so no source folder is ever ignored by accident.
/studio/out/
/studio/build/
/studio/.remotion/

# Stray media from manual runs anywhere outside the tracked reference folders.
/*.mp4
/*.mov
/*.webm
/studio/*.mp4
/studio/*.png

# Tool caches and logs
*.tsbuildinfo
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
